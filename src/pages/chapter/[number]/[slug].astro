---
import { getCollection } from 'astro:content';
import Layout from '../../../components/Layout.astro';
import ChapterView from '../../../components/ChapterView.astro';
import { chapterParts, isHomeChapter, type Chapter } from '../../../lib/chapters';

interface Props {
    chapter: Chapter;
}

export async function getStaticPaths() {
    const chapters = await getCollection('chapters');
    return chapters.map((chapter: Chapter) => {
        const { number, slug } = chapterParts(chapter);
        return {
            params: { number, slug },
            props: { chapter },
        };
    });
}

const { chapter } = Astro.props;

// The opening chapter's canonical URL is the site root, and two URLs for one
// chapter is one too many: this route sends the reader to it.
if (isHomeChapter(chapter)) {
    return Astro.redirect('/', 301);
}
---

<Layout title={`${chapter.data.title} — Brother Dustfish`}>
    <ChapterView chapter={chapter} />
</Layout>
