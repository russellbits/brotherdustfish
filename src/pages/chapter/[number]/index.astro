---
import { getCollection } from 'astro:content';
import { chapterHref, chapterParts, orderedChapters, type Chapter } from '../../../lib/chapters';

interface Props {
    href: string;
}

// `/chapter/01/` has no title of its own; it expands to the canonical URL for
// whichever chapter owns that number — which for the opening chapter is `/`.
// Building the destination with chapterHref keeps that rule in one place, so
// this route never has to know which chapter the front door belongs to.
export async function getStaticPaths() {
    const chapters = orderedChapters(await getCollection('chapters'));
    return chapters.map((chapter: Chapter) => {
        const { number } = chapterParts(chapter);
        return {
            params: { number },
            props: { href: chapterHref(chapter) },
        };
    });
}

const { href } = Astro.props;

return Astro.redirect(href, 301);
---
