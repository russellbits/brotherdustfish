---
import { getCollection, render } from 'astro:content';
import Layout from '../../components/Layout.astro';
import ChapterNav from '../../components/ChapterNav.astro';

export async function getStaticPaths() {
    const chapters = await getCollection('chapters');
    return chapters.map(chapter => {
        const id = String(chapter.data.number).padStart(2, '0');
        return {
            params: { id },
            props: { chapter },
        };
    });
}

const { chapter } = Astro.props;
const { Content } = await render(chapter);
---

<Layout title={`${chapter.data.title} — Brother Dustfish`}>
    <article class="chapter-content">
        <div class="chapter-ref">Chapter {chapter.data.number}</div>
        <h1>{chapter.data.title}</h1>
        <div class="chapter-summary">
            <h4>{chapter.data.summary}</h4>
        </div>
        <div class="chapter-body">
            <Content />
        </div>
        <ChapterNav currentNumber={chapter.data.number} />
    </article>
</Layout>

<style lang="scss">
    .chapter-content {
        width: 100%;
        padding: 0 1rem;

        .chapter-summary {
            text-align: center;
            margin-bottom: 3rem;
            h4 {
                font-style: italic;
                font-weight: normal;
                max-width: 60ch;
                margin: 0 auto;
            }
        }
    }
</style>
