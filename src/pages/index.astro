---
import Layout from '../components/Layout.astro';
---

<Layout title="Brother Dustfish — A Novel by R.E. Warner">
    <div class="landing-content">
        <h1>Brother Dustfish</h1>
        <h2>Greetings!</h2>
        <p>The book is nearing completion (as of May 23, 2026)!</p>
        <p>Enter your email below to get a release notification.</p>
        
        <form class="email-form">
            <input type="text" placeholder="email@example.com" />
            <button type="submit">Submit</button>
        </form>
        
        <div class="start-reading">
            <a href="/chapter/01" class="cta-button">Start Reading</a>
        </div>
    </div>
</Layout>

<style lang="scss">
    .landing-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        height: 100vh;
        padding: 2rem;

        h1 {
            font-family: 'Georgia', serif;
            font-size: 3rem;
            margin-bottom: 1rem;
        }
        h2 {
            font-family: 'Georgia', serif;
            font-size: 2rem;
            margin-bottom: 1rem;
        }
        p {
            font-family: 'Georgia', serif;
            margin-bottom: 0.5rem;
        }

        .email-form {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            margin: 2rem 0;
            
            input {
                padding: 0.8rem;
                border: 1px solid #ccc;
                border-radius: 4px;
                width: 300px;
            }
            button {
                padding: 0.8rem;
                background: green;
                color: white;
                border: none;
                border-radius: 4px;
                cursor: pointer;
                font-weight: bold;
            }
        }

        .start-reading {
            margin-top: 3rem;
            
            .cta-button {
                font-family: 'Georgia', serif;
                font-size: 1.5rem;
                padding: 1rem 2rem;
                background: black;
                color: white;
                text-decoration: none;
                border-radius: 4px;
                transition: background 0.3s ease;

                &:hover {
                    background: #333;
                }
            }
        }
    }
</style>
