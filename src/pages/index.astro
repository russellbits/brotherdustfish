---
import { getCollection } from 'astro:content';
import Layout from '../components/Layout.astro';
import Ribbon from '../components/Ribbon.astro';
import ChapterView from '../components/ChapterView.astro';
import { isHomeChapter } from '../lib/chapters';

// The home page is chapter 1. The chapter's own route redirects here, so this is
// the only place it renders — and replacing the front door later means replacing
// this file, not unpicking a chapter.
const home = (await getCollection('chapters')).find(isHomeChapter);

if (!home) {
    throw new Error(
        'No chapter folder numbered 01: the home page renders it and has nothing to show.',
    );
}
---

<Layout title={`${home.data.title} — Brother Dustfish`}>
    <Ribbon />
    <ChapterView chapter={home} />
</Layout>
