---
import { getCollection } from 'astro:content';
import Layout from '../components/Layout.astro';
import { chapterHref, orderedChapters } from '../lib/chapters';

const firstChapter = orderedChapters(await getCollection('chapters'))[0];
---

<Layout title="Brother Dustfish — A Novel by R.E. Warner">
    <div class="landing-content">
        <h1>Brother Dustfish</h1>
        <h2>Greetings!</h2>
        <p>The book is nearing completion (as of May 23, 2026)!</p>
        <p>Enter your email below to get a release notification.</p>

        <form class="email-form">
            <input type="text" placeholder="email@example.com" />
            <button type="submit">Submit</button>
        </form>

        <div class="start-reading">
            <a href={chapterHref(firstChapter)} class="cta-button">Start Reading</a>
        </div>
    </div>
</Layout>

<style lang="scss">
    .landing-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        height: 100vh;
        padding: 2rem;

        h1 {
            font-family: 'Georgia', serif;
            font-size: 3rem;
            margin-bottom: 1rem;
        }
        h2 {
            font-family: 'Georgia', serif;
            font-size: 2rem;
            margin-bottom: 1rem;
        }
        p {
            font-family: 'Georgia', serif;
            margin-bottom: 0.5rem;
        }

        .email-form {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            margin: 2rem 0;

            input {
                padding: 0.8rem;
                border: 1px solid var(--border-color);
                border-radius: 4px;
                width: 300px;
                background: var(--bg-color);
                color: var(--text-color);
                transition: border-color 0.3s ease, background-color 0.3s ease, color 0.3s ease;

                &::placeholder {
                    color: var(--text-muted);
                }
            }
            button {
                padding: 0.8rem;
                background: var(--accent-color);
                color: var(--accent-contrast);
                border: none;
                border-radius: 4px;
                cursor: pointer;
                font-weight: bold;
                transition: background-color 0.3s ease, color 0.3s ease;
            }
        }

        .start-reading {
            margin-top: 3rem;

            .cta-button {
                font-family: 'Georgia', serif;
                font-size: 1.5rem;
                padding: 1rem 2rem;
                background: var(--text-color);
                color: var(--bg-color);
                text-decoration: none;
                border-radius: 4px;
                transition: background-color 0.3s ease, color 0.3s ease;

                &:hover {
                    background: var(--accent-color);
                    color: var(--accent-contrast);
                }
            }
        }
    }
</style>
