---
---
<div id="coverZoom" class="cover-zoom">
    <img src="/images/3D-book-cover.png" alt="Book Cover" />
</div>

<script>
    import { TABLET_QUERY } from '../lib/breakpoints';

    // Both halves of the interaction are delegated from `document` on purpose.
    // The ClientRouter swaps the body without reloading and Astro only runs each
    // module script once, so a listener bound directly to #coverZoom would vanish
    // after the first in-site navigation. #coverTrigger lives in the persisted
    // sidebar, but keeping the open/close logic together avoids that split.
    function overlay() {
        return document.getElementById('coverZoom');
    }

    function isOpen() {
        return overlay()?.classList.contains('is-visible') ?? false;
    }

    function setVisible(visible: boolean) {
        overlay()?.classList.toggle('is-visible', visible);
    }

    document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;

        // Opening: the sidebar cover. It is a <button>, so there is no default action
        // to suppress and the ClientRouter never sees an anchor.
        //
        // Suppressed only in the splash, where the cover already fills the screen and
        // tapping it scrolls to the sign-up — enlarging an image that is already
        // screen-sized achieves nothing. On a chapter page the cover is a 120px
        // header image at every width, and enlarging it is the whole point.
        //
        // Gating on the page rather than on the viewport is what keeps that control
        // alive: keyed on width, it was dead at every size below the breakpoint, on
        // chapter pages included.
        const trigger = event.target.closest('#coverTrigger');
        if (trigger) {
            if (trigger.closest('[data-splash]') && window.matchMedia(TABLET_QUERY).matches) return;
            setVisible(!isOpen());
            return;
        }

        // Closing: anywhere on the interstitial, including the enlarged cover.
        if (event.target.closest('#coverZoom')) {
            setVisible(false);
        }
    });

    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && isOpen()) {
            setVisible(false);
        }
    });
</script>

<style lang="scss">
    .cover-zoom {
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.5s ease, visibility 0.5s ease;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        // Must sit above both fixed toggles (.nav-toggle at 1001, .theme-toggle
        // at 1100) or they stay clickable through what should be a full-page
        // interstitial — and clicking them would not dismiss the cover.
        z-index: 1200;
        background-color: var(--cover-overlay);
        cursor: pointer;

        img {
            max-width: 90%;
            max-height: 90%;
            object-fit: contain;
        }

        &.is-visible {
            opacity: 1;
            visibility: visible;
        }
    }
</style>
