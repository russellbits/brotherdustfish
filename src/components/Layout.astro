---
import Sidebar from './Sidebar.astro';
import CoverZoom from './CoverZoom.astro';
import ThemeToggle from './ThemeToggle.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/main.scss';

interface Props {
    title?: string;
    /**
     * True only on the landing page. Below 1024px that page's sidebar becomes the
     * site's cover — cover art and the sign-up form on a full-height stage —
     * while chapter pages keep a compact header so the prose starts near the top.
     */
    splash?: boolean;
}

const { title = "Brother Dustfish", splash = false } = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <script is:inline>
            (function () {
                try {
                    var stored = localStorage.getItem('theme');
                    var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                    var theme = stored === 'dark' || stored === 'light' ? stored : (prefersDark ? 'dark' : 'light');
                    document.documentElement.dataset.theme = theme;
                } catch (e) {
                    document.documentElement.dataset.theme = 'light';
                }
            })();
        </script>
        <ClientRouter />
        <script>
            // Bundled rather than pulled from a CDN, so Astro dedupes it and the
            // script keeps working if security.csp is ever enabled. The reveal
            // listener inside drops-client is delegated to the document, because
            // htmx fires htmx:afterSwap on the swap target — which is a sibling of
            // the link for sentence and paragraph modes.
            import htmx from 'htmx.org';
            import '../scripts/drops-client.ts';

            // htmx initialises the document once, on load, and then watches for
            // nothing: there is no MutationObserver anywhere in it (verified in
            // 2.0.11), and its ESM build does not set window.htmx. Astro's
            // ClientRouter replaces the page body on every in-site navigation, so a
            // drop link that arrived that way keeps inert hx-get attributes — the
            // click is never cancelled, nothing swaps, and the browser follows the
            // href to the fragment URL instead.
            //
            // Re-processing after each page load is the documented
            // htmx-with-a-router pattern. It is idempotent, because processNode()
            // skips any node whose attribute hash it has already seen.
            //
            // This lives in the layout rather than in drops-client.ts because
            // importing htmx evaluates it, and it reads `location` at module scope —
            // so a module that imports it can no longer be imported by node:test.
            document.addEventListener('astro:page-load', () => {
                htmx.process(document.body);
            });
        </script>
    </head>
    <body class="layout-wrapper">
        <div id="navToggle" class="nav-toggle">
            <svg id="arrow" width="16px" height="16px" viewBox="0 0 16 16" aria-hidden="true">
                <polygon points="11 2 11 14 4 8" fill="currentColor" />
            </svg>
        </div>
        <Sidebar splash={splash} />
        <main class="main-content">
            <slot />
        </main>
        <CoverZoom />
        <ThemeToggle />
        <script>
            // Delegate from document so the toggle keeps working after
            // ClientRouter swaps the page body (module scripts run only once).
            document.addEventListener('click', (e) => {
                if (!(e.target instanceof Element) || !e.target.closest('#navToggle')) return;
                document.querySelector('.layout-wrapper')?.classList.toggle('sidebar-collapsed');
                document.getElementById('sidebar')?.classList.toggle('hidden');
            });
        </script>
        <script>
            // Marks each chapter navigation as forward or backward so the CSS can
            // pick the matching slide direction. Capture phase on document is what
            // makes this work: the ClientRouter registers its own click handler in
            // the bubble phase, so we always decide the direction before it calls
            // startViewTransition().
            const CHAPTER_NUMBER = /^\/chapter\/(\d+)(?:\/|$)/;

            function chapterNumber(pathname: string): number | null {
                const match = CHAPTER_NUMBER.exec(pathname);
                return match ? Number(match[1]) : null;
            }

            // The sidebar can jump arbitrary distances, so compare chapter numbers
            // rather than assuming adjacent pages.
            let currentNumber = chapterNumber(location.pathname);

            function markDirection(targetNumber: number | null) {
                const backward =
                    currentNumber !== null && targetNumber !== null && targetNumber < currentNumber;
                document.documentElement.dataset.navDirection = backward ? 'back' : 'forward';
            }

            document.addEventListener(
                'click',
                (event) => {
                    // Mirror the modifiers Astro itself uses to bail out of a
                    // client-side transition (new tab, forced download, etc.).
                    if (event.button !== 0 || event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) {
                        return;
                    }
                    const origin = event.target;
                    if (!(origin instanceof Element)) return;
                    const anchor = origin.closest('a[href]');
                    if (!(anchor instanceof HTMLAnchorElement)) return;
                    if (anchor.origin !== location.origin || anchor.hash) return;

                    const target = chapterNumber(anchor.pathname);
                    if (target !== null) markDirection(target);
                },
                { capture: true },
            );

            // Browser back/forward has no click to inspect; the URL is already the
            // destination when popstate fires, so compare it against where we are.
            window.addEventListener(
                'popstate',
                () => markDirection(chapterNumber(location.pathname)),
                { capture: true },
            );

            // History is updated before Astro fires this event, so location is the
            // newly swapped page here.
            document.addEventListener('astro:after-swap', () => {
                currentNumber = chapterNumber(location.pathname);
            });
        </script>
    </body>
</html>
