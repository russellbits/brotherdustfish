---
import Sidebar from './Sidebar.astro';
import CoverZoom from './CoverZoom.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/main.scss';

interface Props {
    title?: string;
}

const { title = "Brother Dustfish" } = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <ClientRouter />
    </head>
    <body class="layout-wrapper">
        <div id="navToggle" class="nav-toggle">
            <svg id="arrow" width="16px" height="16px" viewBox="0 0 38 72">
                <polygon points="742 119 778 157 706 157" fill="white" />
            </svg>
        </div>
        <Sidebar />
        <main class="main-content">
            <slot />
        </main>
        <CoverZoom />
        <script>
            const toggle = document.getElementById('navToggle');
            const sidebar = document.getElementById('sidebar');
            const wrapper = document.querySelector('.layout-wrapper');

            toggle?.addEventListener('click', () => {
                wrapper?.classList.toggle('sidebar-collapsed');
                sidebar?.classList.toggle('hidden');
            });
        </script>
    </body>
</html>
