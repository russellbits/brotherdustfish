---
import Sidebar from './Sidebar.astro';
import CoverZoom from './CoverZoom.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/main.scss';

interface Props {
    title?: string;
}

const { title = "Brother Dustfish" } = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <ClientRouter />
    </head>
    <body>
        <div class="layout-wrapper">
            <Sidebar />
            <main class="main-content">
                <slot />
            </main>
        </div>
        <CoverZoom />
    </body>
</html>
