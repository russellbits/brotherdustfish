---
import { getCollection } from 'astro:content';
import { chapterHref, orderedChapters } from '../lib/chapters';

interface Props {
    currentNumber: number;
}

const { currentNumber } = Astro.props;
const sortedChapters = orderedChapters(await getCollection('chapters'));
const currentIndex = sortedChapters.findIndex(c => c.data.number === currentNumber);
const prev = currentIndex > 0 ? sortedChapters[currentIndex - 1] : null;
const next = currentIndex < sortedChapters.length - 1 ? sortedChapters[currentIndex + 1] : null;
---

<div class="chapter-nav">
    <div class="nav-links">
        {prev && (
            <a href={chapterHref(prev)} class="nav-link">
                ← Previous Chapter: {prev.data.title}
            </a>
        )}
        {next && (
            <a href={chapterHref(next)} class="nav-link">
                Next Chapter: {next.data.title} →
            </a>
        )}
    </div>
</div>

<style lang="scss">
    .chapter-nav {
        width: 100%;
        display: flex;
        justify-content: center;
        margin: 4rem 0;
        padding: 2rem;
        border-top: 1px solid var(--border-color);

        .nav-links {
            display: flex;
            gap: 2rem;
            justify-content: space-between;
            width: 80%;
            max-width: 80ch;
        }

        .nav-link {
            font-family: 'Georgia', serif;
            text-decoration: none;
            color: var(--text-color);
            font-weight: bold;
            transition: color 0.3s ease;

            &:hover {
                color: var(--accent-color);
            }
        }
    }
</style>
