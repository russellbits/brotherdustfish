---
// Replaces each scene break — <hr>, written as `* * *` in the chapter MDX —
// inside .chapter-body with a small Conway's Game of Life ornament. Ordinary
// paragraph joins keep the indented book flow with no ornament.
// Include once per page that renders chapter content.
---

<script>
    const CELL = 6; // px per cell (square + gap)
    const ROWS = 3; // divider is a 3-row strip
    const TICK_MS = 400;
    const MAX_GENS = 48;
    const SEED_DENSITY = 0.32;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Deterministic per break: same chapter + same paragraph index always yields
    // the same opening sequence, but every break gets its own.
    function hashSeed(text) {
        let h = 2166136261;
        for (let i = 0; i < text.length; i++) {
            h ^= text.charCodeAt(i);
            h = Math.imul(h, 16777619);
        }
        return h >>> 0;
    }

    function mulberry32(a) {
        return function () {
            a = (a + 0x6d2b79f5) | 0;
            let t = Math.imul(a ^ (a >>> 15), 1 | a);
            t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
            return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
        };
    }

    // Standard B3/S23 rules on a toroidal grid, so patterns never hit a dead edge.
    function step(current, cols, rows) {
        const next = new Uint8Array(current.length);
        for (let y = 0; y < rows; y++) {
            for (let x = 0; x < cols; x++) {
                let neighbours = 0;
                for (let dy = -1; dy <= 1; dy++) {
                    for (let dx = -1; dx <= 1; dx++) {
                        if (dx === 0 && dy === 0) continue;
                        const nx = (x + dx + cols) % cols;
                        const ny = (y + dy + rows) % rows;
                        neighbours += current[ny * cols + nx];
                    }
                }
                const alive = current[y * cols + x] === 1;
                next[y * cols + x] = alive ? (neighbours === 2 || neighbours === 3 ? 1 : 0)
                                           : (neighbours === 3 ? 1 : 0);
            }
        }
        return next;
    }

    class LifeBreak {
        constructor(canvas, seed) {
            this.canvas = canvas;
            this.ctx = canvas.getContext('2d');
            this.rand = mulberry32(seed);
            this.resize();
            this.draw();
        }

        resize() {
            const dpr = Math.min(window.devicePixelRatio || 1, 2);
            const cssWidth = this.canvas.getBoundingClientRect().width || 240;
            this.cols = Math.max(8, Math.floor(cssWidth / CELL));
            this.gridWidth = this.cols * CELL;
            this.gridHeight = ROWS * CELL;
            this.canvas.width = Math.round(this.gridWidth * dpr);
            this.canvas.height = Math.round(this.gridHeight * dpr);
            this.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            this.readColor();
            this.reseed();
        }

        readColor() {
            this.color = getComputedStyle(this.canvas).color;
        }

        reseed() {
            this.grid = new Uint8Array(this.cols * ROWS);
            for (let i = 0; i < this.grid.length; i++) {
                this.grid[i] = this.rand() < SEED_DENSITY ? 1 : 0;
            }
            this.generation = 0;
        }

        tick() {
            this.grid = step(this.grid, this.cols, ROWS);
            this.generation++;

            let population = 0;
            for (let i = 0; i < this.grid.length; i++) population += this.grid[i];

            // Retire the sequence once it burns out, saturates, or settles into a
            // long run, then start a fresh random one.
            const cells = this.grid.length;
            if (population < cells * 0.06 || population > cells * 0.55 || this.generation >= MAX_GENS) {
                this.reseed();
            }
            this.draw();
        }

        draw() {
            const { ctx } = this;
            ctx.clearRect(0, 0, this.gridWidth, this.gridHeight);
            ctx.fillStyle = this.color;
            for (let y = 0; y < ROWS; y++) {
                for (let x = 0; x < this.cols; x++) {
                    if (this.grid[y * this.cols + x] === 1) {
                        ctx.fillRect(x * CELL + 1, y * CELL + 1, CELL - 2, CELL - 2);
                    }
                }
            }
        }
    }

    const instances = new Map();
    let ticker = null;

    function teardown() {
        instances.clear();
        if (ticker !== null) {
            clearInterval(ticker);
            ticker = null;
        }
    }

    function mount() {
        document.querySelectorAll('.life-break').forEach((canvas) => {
            if (instances.has(canvas)) return;
            instances.set(canvas, new LifeBreak(canvas, Number(canvas.dataset.lifeSeed) || 1));
        });
        if (ticker === null && !reduceMotion.matches && instances.size > 0) {
            ticker = setInterval(() => {
                instances.forEach((instance) => instance.tick());
            }, TICK_MS);
        }
    }

    function injectBreaks() {
        document.querySelectorAll('.chapter-body').forEach((body) => {
            body.querySelectorAll('hr').forEach((hr, index) => {
                const canvas = document.createElement('canvas');
                canvas.className = 'life-break';
                canvas.setAttribute('aria-hidden', 'true');
                canvas.dataset.lifeSeed = String(
                    hashSeed(`${location.pathname}:hr:${index}`),
                );
                hr.replaceWith(canvas);
            });
        });
        mount();
    }

    // ClientRouter swaps the body without reloading, so re-inject after each swap
    // and drop the old animation handles before it.
    document.addEventListener('astro:before-swap', teardown);
    document.addEventListener('astro:after-swap', injectBreaks);

    let resizeTimer = null;
    window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
            instances.forEach((instance) => {
                instance.resize();
                instance.draw();
            });
        }, 150);
    });

    // Keep the ornament in sync with the day/night theme.
    new MutationObserver(() => {
        instances.forEach((instance) => {
            instance.readColor();
            instance.draw();
        });
    }).observe(document.documentElement, { attributeFilter: ['data-theme'] });

    reduceMotion.addEventListener('change', () => {
        teardown();
        mount();
    });

    injectBreaks();
</script>

<style is:global lang="scss">
    .life-break {
        display: block;
        width: min(240px, 55%);
        height: 18px; // ROWS * CELL
        margin: 2.5rem auto;
        color: var(--text-muted);
        opacity: 0.75;
    }
</style>
