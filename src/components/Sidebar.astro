---
import { getCollection } from 'astro:content';
import { orderedChapters } from '../lib/chapters';
import SignupForm from './SignupForm.astro';
import TocList from './TocList.astro';

interface Props {
    /**
     * True on the landing page. Below 1024px that page's sidebar is the site's
     * cover: a full-height stage holding the cover art and the sign-up form.
     * Chapter pages get a compact header instead, so that arriving at a chapter
     * never makes the reader scroll a whole screen before reaching any prose.
     */
    splash?: boolean;
}

const { splash = false } = Astro.props;
const sortedChapters = orderedChapters(await getCollection('chapters'));
---

<div class="sidebar" transition:persist id="sidebar" data-splash={splash ? 'true' : undefined}>
    <div class="sidebar-content">
        <h1 class="book-title"><a href="/">Brother Dustfish</a></h1>
        <!-- A button, not <a href="#">: the ClientRouter intercepts any click on
             `a, area` and treats a same-page href as a real navigation, which
             swapped the body out from under the freshly opened overlay. -->
        <!-- <picture>, not a swapped src, so a phone downloads only the art it
             renders: the splash wants the large cover, while the desktop sidebar
             and the chapter-page header keep the 100 KB thumbnail. -->
        <button type="button" id="coverTrigger" class="cover-trigger" aria-label="Show the cover larger">
            <picture>
                <source
                    media="(max-width: 1023px)"
                    srcset={splash ? '/images/book-cover-900x1245.jpg' : '/images/3D-book-cover-sm.png'}
                />
                <!-- The alt names the book rather than describing the file: on
                     mobile the wordmark is hidden and this is the only text that
                     identifies the site. -->
                <img src="/images/3D-book-cover-sm.png" alt="Brother Dustfish — book cover" />
            </picture>
        </button>

        {
            splash && (
                <div class="splash-signup">
                    <SignupForm />
                </div>
            )
        }

        <!-- The table of contents is rendered twice on purpose: a visible list on
             desktop, and a native disclosure below it. A single <details> cannot
             be forced open by CSS reliably, because browsers hide its closed
             content in a way author styles do not always override. TocList keeps
             the chapter markup in one place. -->
        <nav class="toc" aria-label="Table of contents">
            <h2>Table of Contents</h2>
            <TocList chapters={sortedChapters} />
        </nav>

        <details class="toc-disclosure">
            <summary>Table of Contents</summary>
            <TocList chapters={sortedChapters} />
        </details>
    </div>
</div>

<script>
    // Mobile only, and only when a chapter was chosen from the contents: dismiss the
    // disclosure and land the reader at the top of the chapter content rather than
    // on the header the sidebar leaves above it.
    const MOBILE = '(max-width: 1023px)';
    let choseChapter = false;

    document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const link = target.closest('.toc-disclosure a');
        if (!link) return;

        choseChapter = true;

        // The sidebar carries `transition:persist`, so it survives the navigation
        // and an opened disclosure would still be open on the chapter page.
        const disclosure = link.closest('details');
        if (disclosure instanceof HTMLDetailsElement) disclosure.open = false;
    });

    // astro:page-load rather than astro:after-swap: it fires once the new page is
    // ready and the router has settled the scroll position, so scrolling earlier
    // would simply be overwritten.
    document.addEventListener('astro:page-load', () => {
        if (!choseChapter) return;
        choseChapter = false;

        if (!window.matchMedia(MOBILE).matches) return;
        document.querySelector('.main-content')?.scrollIntoView({ block: 'start' });
    });

    // Tapping the cover takes the reader to the sign-up.
    //
    // The cover fills the first screen on mobile, so the form is deliberately below
    // the fold — this tap is the affordance that reaches it. The zoom overlay is a
    // desktop affordance for the small 3D thumbnail and is suppressed at this width
    // in CoverZoom, because enlarging an already screen-sized cover achieves nothing.
    document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        if (!target.closest('#coverTrigger')) return;
        if (!window.matchMedia(MOBILE).matches) return;

        document.querySelector('.splash-signup')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
</script>

<style lang="scss">
    .sidebar-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 2rem 1rem;
        text-align: center;
        color: var(--text-color-light);
    }

    .cover-trigger {
        // Reset the UA button chrome so the thumbnail looks exactly as it did
        // when this was an anchor.
        appearance: none;
        border: 0;
        margin: 0;
        padding: 0;
        background: none;
        color: inherit;
        font: inherit;
        line-height: 0;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;

        img {
            display: block;
        }

        &:focus-visible {
            outline: 2px solid var(--sidebar-link-hover);
            outline-offset: 4px;
        }
    }

    .book-title {
        font-family: 'Georgia', serif;
        font-size: 3rem;
        font-weight: 900;
        margin: 1rem 0;

        a {
            color: white;
            text-decoration: none;
        }

        a:hover {
            text-decoration: underline;
        }
    }

    // Desktop's always-visible contents. Below 1024px the disclosure replaces it.
    .toc {
        width: 100%;
        margin: 2rem 0 2rem 5rem;
        // The sidebar chrome (title, cover) stays centered; the TOC reads as a
        // left-aligned list.
        text-align: left;

        h2 {
            font-family: 'Georgia', serif;
            font-size: 1.6rem;
            margin-bottom: 1rem;
            padding-bottom: 0.5rem;
        }
    }

    .toc-disclosure {
        display: none;
    }

    @media (max-width: 1023px) {
        // The landing page's sidebar is the site's cover: a full-height stage
        // whose contents are centered down the screen.
        [data-splash] .sidebar-content {
            justify-content: center;
            gap: 1rem;
            // dvh, not vh: on mobile Safari `vh` includes the address bar, so the
            // stage would be taller than the screen and clipped. The vh line is
            // the fallback for browsers without dvh.
            min-height: 100vh;
            min-height: 100dvh;
            padding: 1.5rem 1.25rem;
        }

        // The cover art carries the book's identity on mobile, so the wordmark is
        // redundant — and it was the second "Brother Dustfish" on the landing
        // page, the other being the landing block's h1. Hiding it also buys the
        // vertical room the sign-up form needs to clear the fold.
        [data-splash] .book-title {
            display: none;
        }

        // The landing page's cover is now a whole screen of flat cover art, centred
        // on the dark stage. Tapping it scrolls to the sign-up, so the form is
        // deliberately below the fold on this page.
        // A definite box, then `object-fit`. The first version of this put
        // percentage max-width/max-height on the <img> inside a fit-content flex
        // item, which is a circular size resolution — the parent's width depends on
        // the image, and the image's max-width depends on the parent. Browsers
        // resolve that inconsistently. A definite box has no such ambiguity.
        [data-splash] .cover-trigger {
            display: block;
            width: 100%;
            // The stage's own vertical padding, so a full-height cover still fits
            // inside one screen.
            height: calc(100dvh - 3rem);
        }

        [data-splash] .cover-trigger picture {
            display: block;
            width: 100%;
            height: 100%;
        }

        // `contain`, deliberately, and never `cover`: the cover is a 1.383 ratio
        // while a phone screen is 1.78-2.17, so covering the box would scale it to
        // 542px wide on a 390px screen and crop ~76px from each side — clipping
        // "A Novel by R. E. Warner", whose text begins about 75px in from the left
        // edge. `contain` fills the box as far as the ratio allows and centres what
        // is left, so nothing is ever cropped.
        [data-splash] .cover-trigger img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        // A chapter page's cover is a header, not a splash, so it is capped hard.
        :not([data-splash]) .cover-trigger img {
            width: auto;
            height: auto;
            max-height: 120px;
        }

        .toc {
            display: none;
        }

        .toc-disclosure {
            display: block;
            width: 100%;
            text-align: left;

            summary {
                font-family: 'Georgia', serif;
                font-size: 1.3rem;
                color: var(--text-color-light);
                cursor: pointer;
                padding: 0.6rem 0;
            }

            &[open] summary {
                margin-bottom: 1rem;
            }
        }
    }
</style>
