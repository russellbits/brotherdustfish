---
import { getCollection } from 'astro:content';
import { orderedChapters } from '../lib/chapters';
import { TABLET_QUERY } from '../lib/breakpoints';
import SignupForm from './SignupForm.astro';
import TocList from './TocList.astro';

const sortedChapters = orderedChapters(await getCollection('chapters'));
---

<div class="sidebar" transition:persist id="sidebar">
    <div class="sidebar-content">
        <h1 class="book-title"><a href="/">Brother Dustfish</a></h1>
        <!-- A button, not <a href="#">: the ClientRouter intercepts any click on
             `a, area` and treats a same-page href as a real navigation, which
             swapped the body out from under the freshly opened overlay. -->
        <!-- <picture>, not a swapped src, so a phone downloads only the art it
             renders: below the breakpoint the cover is the front door and wants the
             large flat art, while the desktop sidebar keeps the 100 KB thumbnail. -->
        <button type="button" id="coverTrigger" class="cover-trigger" aria-label="Show the cover larger">
            <picture>
                <!-- Below the breakpoint the cover is the front door of every page, so
                     the flat art replaces the 3D thumbnail there. Above it, the desktop
                     sidebar keeps the thumbnail. -->
                <source media={TABLET_QUERY} srcset="/images/book-cover-900x1245.jpg" />
                <!-- The alt names the book rather than describing the file: on
                     mobile the wordmark is hidden and this is the only text that
                     identifies the site. -->
                <img src="/images/3D-book-cover-sm.png" alt="Brother Dustfish — book cover" />
            </picture>
        </button>

        <!-- One sign-up for the whole site. On desktop it sits below the cover in
             the column; below the breakpoint it is the reason the cover stage
             scrolls, sitting just past the fold. -->
        <div class="cover-signup">
            <SignupForm />
        </div>

        <!-- The table of contents is rendered twice on purpose: a visible list on
             desktop, and a native disclosure below it. A single <details> cannot
             be forced open by CSS reliably, because browsers hide its closed
             content in a way author styles do not always override. TocList keeps
             the chapter markup in one place. -->
        <nav class="toc" aria-label="Table of contents">
            <h2>Table of Contents</h2>
            <TocList chapters={sortedChapters} />
        </nav>

        <details class="toc-disclosure">
            <summary>Table of Contents</summary>
            <TocList chapters={sortedChapters} />
        </details>
    </div>
</div>

<script>
    import { TABLET_QUERY } from '../lib/breakpoints';

    // Below the layout breakpoint, and only when a chapter was chosen from the
    // contents: dismiss the disclosure and land the reader at the top of the chapter
    // content rather than on the header the sidebar leaves above it.
    const STACKED = TABLET_QUERY;
    let choseChapter = false;

    document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const link = target.closest('.toc-disclosure a');
        if (!link) return;

        choseChapter = true;

        // The sidebar carries `transition:persist`, so it survives the navigation
        // and an opened disclosure would still be open on the chapter page.
        const disclosure = link.closest('details');
        if (disclosure instanceof HTMLDetailsElement) disclosure.open = false;
    });

    // astro:page-load rather than astro:after-swap: it fires once the new page is
    // ready and the router has settled the scroll position, so scrolling earlier
    // would simply be overwritten.
    document.addEventListener('astro:page-load', () => {
        if (!choseChapter) return;
        choseChapter = false;

        if (!window.matchMedia(STACKED).matches) return;
        document.querySelector('.main-content')?.scrollIntoView({ block: 'start' });
    });

    // Tapping the cover takes the reader to the sign-up.
    //
    // The cover fills the first screen below the layout breakpoint, so the form is
    // deliberately below the fold — this tap is the affordance that reaches it. The
    // zoom overlay is a desktop affordance for the small 3D thumbnail and is
    // suppressed below the breakpoint, because enlarging an already screen-sized
    // cover achieves nothing.
    document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const control = target.closest('#coverTrigger');
        if (!control) return;
        if (!window.matchMedia(STACKED).matches) return;

        // The cover is a full screen of art on every page, so a tap has to lead
        // somewhere: to the sign-up, which sits just past the fold.
        document.querySelector('.cover-signup')?.scrollIntoView({
            behavior: 'smooth',
            block: 'start',
        });
    });
</script>

<style lang="scss">
    @use '../styles/breakpoint' as *;

    .sidebar-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 2rem 1rem;
        text-align: center;
        color: var(--text-color-light);
    }

    .cover-trigger {
        // Reset the UA button chrome so the thumbnail looks exactly as it did
        // when this was an anchor.
        appearance: none;
        border: 0;
        margin: 0;
        padding: 0;
        background: none;
        color: inherit;
        font: inherit;
        line-height: 0;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;

        img {
            display: block;
        }

        &:focus-visible {
            outline: 2px solid var(--sidebar-link-hover);
            outline-offset: 4px;
        }
    }

    .book-title {
        font-family: 'Georgia', serif;
        font-size: 3rem;
        font-weight: 900;
        margin: 1rem 0;

        a {
            color: white;
            text-decoration: none;
        }

        a:hover {
            text-decoration: underline;
        }
    }

    // Desktop's always-visible contents. Below 1024px the disclosure replaces it.
    .toc {
        width: 100%;
        margin: 2rem 0 2rem 5rem;
        // The sidebar chrome (title, cover) stays centered; the TOC reads as a
        // left-aligned list.
        text-align: left;

        h2 {
            font-family: 'Georgia', serif;
            font-size: 1.6rem;
            margin-bottom: 1rem;
            padding-bottom: 0.5rem;
        }
    }

    .toc-disclosure {
        display: none;
    }

    @media (max-width: $tablet-max) {
        // Below the breakpoint the sidebar is the site's cover: a full-height stage
        // whose contents are centered down the screen, with the sign-up just past
        // the fold. It is the same stage on every page, so the cover's height
        // calculation below is right everywhere.
        .sidebar-content {
            justify-content: center;
            gap: 1rem;
            // dvh, not vh: on mobile Safari `vh` includes the address bar, so the
            // stage would be taller than the screen and clipped. The vh line is
            // the fallback for browsers without dvh.
            min-height: 100vh;
            min-height: 100dvh;
            // 48px above the cover and none below: the total is the 3rem the
            // cover's own height calculation subtracts.
            padding: 48px 0 0 0;
        }

        // The cover carries the book's identity, so the wordmark is redundant below
        // the breakpoint, where the cover is the front door and sizes itself to the
        // screen.
        .book-title {
            display: none;
        }

        // Below the breakpoint the cover is a whole screen of flat art on every page:
        // the reading pane, the sign-up and the contents all sit below it, which is
        // what makes tapping it meaningful.
        .cover-trigger {
            display: block;
            width: 100%;
            // The stage's 3rem of top padding is what clears the contents strip, so
            // the strip never sits over the artwork — the cover's author line is at
            // its top left — and the cover starts where the strip ends.
            //
            // Subtracting the stage's own gap as well is what puts the sign-up just
            // past the fold: cover + gap now lands exactly on 100dvh. Without it the
            // form's top edge — the email field — sat ~32px up inside the first
            // screen, so the cover no longer read as a full screen of cover art.
            height: calc(100dvh - var(--toc-bar) - 1rem);
        }

        .cover-trigger picture {
            display: block;
            width: 100%;
            height: 100%;
        }

        .cover-trigger img {
            display: block;
            width: 100%;
            height: 100%;
            // The box fills the screen on both axes either way; what varies is whether
            // the image inside it fills too, or sits whole within it. Decide that from
            // the box's shape against the cover's own ratio below.
            object-fit: contain;
        }

        // A box narrower than the cover's 900/1245 ratio — every portrait phone, whose
        // box is 0.46-0.56 — scales the image by height, so the *whole* height shows and
        // the excess falls off the right edge. Anchoring left is what keeps the left
        // margin intact, and that margin is where "A Novel by R. E. Warner" and the
        // opening letter of the title sit. Cropping happens inside the box, so nothing
        // overflows the page and there is nothing to scroll sideways.
        @media (max-aspect-ratio: 900 / 1245) {
            .cover-trigger img {
                object-fit: cover;
                object-position: left center;
            }
        }

        // A box *wider* than that ratio — a landscape tablet, at 1.33-1.44 — would scale
        // by width instead and crop vertically, and there is no right-crop to take: the
        // cover's own title sits at the bottom of the image. With the wordmark hidden
        // below this breakpoint, a vertical crop would leave the book unnamed. So on
        // those screens the image is contained: the box still fills the screen, and the
        // whole cover sits inside it.
        //
        // If the cover art is ever replaced, this ratio changes with it.


        .toc {
            display: none;
        }

        // A black strip across the top of the screen whose panel folds down *over* the
        // page: it is fixed, so opening it cannot move the article underneath. Choosing
        // a chapter closes it again — the tap handler already does that, and scrolls to
        // the content.
        .toc-disclosure {
            display: block;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1050;
            background: #000;
            color: var(--text-color-light);
            text-align: left;
            max-height: 100dvh;
            overflow-y: auto;

            summary {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                min-height: var(--toc-bar);
                padding: 0 1.25rem;
                font-family: 'Georgia', serif;
                font-size: 1.05rem;
                color: var(--text-color-light);
                cursor: pointer;
                // The engine-drawn triangle sits differently in every browser; the caret
                // below replaces it.
                list-style: none;

                &::-webkit-details-marker {
                    display: none;
                }

                &::after {
                    content: '▾';
                    margin-left: auto;
                    transition: transform 0.2s ease;
                }
            }

            &[open] {
                padding-bottom: 1.25rem;
            }

            &[open] summary {
                border-bottom: 1px solid rgba(255, 255, 255, 0.15);

                &::after {
                    transform: rotate(180deg);
                }
            }

            // The list is rendered by TocList, so its own styles carry a different
            // scope: this has to reach outside this component to inset it.
            :global(.toc-list) {
                padding: 0 1.25rem;
            }
        }
    }
</style>
