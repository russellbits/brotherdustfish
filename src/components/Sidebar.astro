---
import { TABLET_QUERY } from '../lib/breakpoints';
import EarlyPurchaseDialog from './EarlyPurchaseDialog.astro';
---

<div class="sidebar" transition:persist id="sidebar">
    <div class="sidebar-content">
        <!-- A button, not <a href="#">: the ClientRouter intercepts any click on
             `a, area` and treats a same-page href as a real navigation, which
             swapped the body out from under the freshly opened overlay. -->
        <!-- <picture>, not a swapped src, so a phone downloads only the art it
             renders: below the breakpoint the cover is the front door and wants the
             large flat art, while the desktop sidebar keeps the 100 KB thumbnail. -->
        <button type="button" id="coverTrigger" class="cover-trigger" aria-label="Show the cover larger">
            <picture>
                <!-- Below the breakpoint the cover is the front door of every page, so
                     the flat art replaces the 3D thumbnail there. Above it, the desktop
                     sidebar keeps the thumbnail. -->
                <source media={TABLET_QUERY} srcset="/images/book-cover-900x1245.jpg" />
                <!-- The alt names the book rather than describing the file: on
                     mobile the wordmark is hidden and this is the only text that
                     identifies the site. -->
                <img src="/images/3D-book-cover-sm.png" alt="Brother Dustfish — book cover" />
            </picture>
        </button>
        <h1 class="book-title"><a href="/">Brother Dustfish</a></h1>
        <h4>A Novel in Progress by</h4>
        <h3><a href="https://www.goodreads.com/author/show/5019350.R_E_Warner">R.E. Warner</a></h3>
        <!-- The sidebar's job is these three actions; the contents are the tab at the
             top of the screen now.
             The downloads are the *served* path, not the authored one: Astro copies
             public/ verbatim, so the file at public/downloads/x.pdf is served from
             /downloads/x.pdf and a /public/... href would 404. -->
        <div class="sidebar-actions">
            <a class="sidebar-action" href="/downloads/brother-dustfish.250922.pdf" download>
                Downloads
            </a>
            <!--<a class="sidebar-action" href="/downloads/brother-dustfish.250922.epub" download>-->
            <EarlyPurchaseDialog />
        </div>
    </div>
</div>

<script>
    import { TABLET_QUERY } from '../lib/breakpoints';

    // Tapping the cover reaches the actions. Below the breakpoint the cover is a whole
    // screen of art, so everything the sidebar holds is past the fold and the tap is
    // the affordance that gets there. The zoom overlay is a desktop affordance for the
    // small 3D thumbnail and is suppressed below the breakpoint, because enlarging an
    // already screen-sized cover achieves nothing.
    document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        if (!target.closest('#coverTrigger')) return;
        if (!window.matchMedia(TABLET_QUERY).matches) return;

        document.querySelector('.sidebar-actions')?.scrollIntoView({
            behavior: 'smooth',
            block: 'start',
        });
    });
</script>

<style lang="scss">
    @use '../styles/breakpoint' as *;

    .sidebar-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 2rem 1rem;
        text-align: center;
        color: var(--text-color-light);
    }

    .cover-trigger {
        // Reset the UA button chrome so the thumbnail looks exactly as it did
        // when this was an anchor.
        appearance: none;
        border: 0;
        margin: 0;
        padding: 0;
        background: none;
        color: inherit;
        font: inherit;
        line-height: 0;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;

        img {
            display: block;
        }

        &:focus-visible {
            outline: 2px solid var(--sidebar-link-hover);
            outline-offset: 4px;
        }
    }

    .book-title {
        font-family: 'Georgia', serif;
        font-size: 3rem;
        font-weight: 900;
        margin: 1rem 0;

        a {
            color: white;
            text-decoration: none;
        }

        a:hover {
            text-decoration: underline;
        }
    }

    .sidebar-actions {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        width: min(100%, 18rem);
        margin-top: 2rem;
    }

    // `:global` because the early-purchase button is rendered by the dialog component,
    // which carries a different style scope, so its element cannot match a scoped rule
    // here. The class is the contract between the two components.
    :global(.sidebar-action) {
        padding: 0.7rem 1rem;
        border: 1px solid var(--text-color-light);
        border-radius: 4px;
        background: transparent;
        color: var(--text-color-light);
        font-family: 'Georgia', serif;
        font-size: 1rem;
        text-align: center;
        text-decoration: none;
        cursor: pointer;
        transition: background-color 0.3s ease, color 0.3s ease;

        &:hover {
            background: var(--text-color-light);
            color: #000;
        }

        &:focus-visible {
            outline: 2px solid var(--sidebar-link-hover);
            outline-offset: 2px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        :global(.sidebar-action) {
            transition: none;
        }
    }

    @media (max-width: $tablet-max) {
        // Below the breakpoint the sidebar is the site's cover: a full-height stage
        // whose contents are centered down the screen, with the actions just past
        // the fold. It is the same stage on every page, so the cover's height
        // calculation below is right everywhere.
        .sidebar-content {
            justify-content: center;
            gap: 1rem;
            // dvh, not vh: on mobile Safari `vh` includes the address bar, so the
            // stage would be taller than the screen and clipped. The vh line is
            // the fallback for browsers without dvh.
            min-height: 100vh;
            min-height: 100dvh;
            // 48px above the cover and none below: the total is the 3rem the
            // cover's own height calculation subtracts.
            padding: 48px 0 0 0;
        }

        // The cover carries the book's identity, so the wordmark is redundant below
        // the breakpoint, where the cover is the front door and sizes itself to the
        // screen.
        .book-title {
            display: none;
        }

        // Below the breakpoint the cover is a whole screen of flat art on every page:
        // the reading pane and the actions all sit below it, which is what makes
        // tapping it meaningful.
        .cover-trigger {
            display: block;
            width: 100%;
            // The stage's 3rem of top padding is what clears the contents tab, so the
            // tab never sits over the artwork — the cover's author line is at its top
            // left — and the cover starts where the tab ends.
            //
            // Subtracting the stage's own gap as well is what puts the actions just
            // past the fold: cover + gap now lands exactly on 100dvh. Without it the
            // top of the actions sat ~32px up inside the first screen, so the cover no
            // longer read as a full screen of cover art.
            height: calc(100dvh - var(--toc-bar) - 1rem);
        }

        .cover-trigger picture {
            display: block;
            width: 100%;
            height: 100%;
        }

        .cover-trigger img {
            display: block;
            width: 100%;
            height: 100%;
            // The box fills the screen on both axes either way; what varies is whether
            // the image inside it fills too, or sits whole within it. Decide that from
            // the box's shape against the cover's own ratio below.
            object-fit: contain;
        }

        // A box narrower than the cover's 900/1245 ratio — every portrait phone, whose
        // box is 0.46-0.56 — scales the image by height, so the *whole* height shows and
        // the excess falls off the right edge. Anchoring left is what keeps the left
        // margin intact, and that margin is where "A Novel by R. E. Warner" and the
        // opening letter of the title sit. Cropping happens inside the box, so nothing
        // overflows the page and there is nothing to scroll sideways.
        @media (max-aspect-ratio: 900 / 1245) {
            .cover-trigger img {
                object-fit: cover;
                object-position: left center;
            }
        }

        // A box *wider* than that ratio — a landscape tablet, at 1.33-1.44 — would scale
        // by width instead and crop vertically, and there is no right-crop to take: the
        // cover's own title sits at the bottom of the image. With the wordmark hidden
        // below this breakpoint, a vertical crop would leave the book unnamed. So on
        // those screens the image is contained: the box still fills the screen, and the
        // whole cover sits inside it.
        //
        // If the cover art is ever replaced, this ratio changes with it.
    }
</style>
