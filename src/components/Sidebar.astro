---
import { getCollection } from 'astro:content';
const allChapters = await getCollection('chapters');
const sortedChapters = allChapters.sort((a, b) => a.data.number - b.data.number);
---
<div class="sidebar" transition:persist id="sidebar">
    <div class="sidebar-content">
        <a href="#" id="coverTrigger">
            <img src="/images/3D-book-cover-sm.png" alt="Book Cover Preview" width="200" height="277" />
        </a>
        
        <h1 class="book-title">Brother Dustfish</h1>
        <div class="toc">
            <h2>Chapters</h2>
            <ul>
                {sortedChapters.map(chapter => (
                    <li>
                        <a href={`/chapter/${String(chapter.data.number).padStart(2, '0')}`}>
                            Chapter {chapter.data.number}: {chapter.data.title}
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </div>
</div>

<script>
    // The trigger is now in the Layout, but we still need the zoom logic
    const trigger = document.getElementById('coverTrigger');
    trigger?.addEventListener('click', (e) => {
        e.preventDefault();
        const zoom = document.getElementById('coverZoom');
        zoom?.classList.toggle('is-visible');
    });
</script>

<style lang="scss">
    .sidebar-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 2rem 1rem;
        text-align: center;
        color: white;
    }

    .book-title {
        font-family: 'Georgia', serif;
        font-size: 1.5rem;
        font-weight: 900;
        margin: 1rem 0;
    }

    .toc {
        width: 100%;
        margin-top: 2rem;
        
        h2 {
            font-family: 'Georgia', serif;
            font-size: 1.2rem;
            margin-bottom: 1rem;
            border-bottom: 1px solid white;
            padding-bottom: 0.5rem;
        }
        
        ul {
            list-style: none;
            padding: 0;
            display: flex;
            flex-direction: column;
            gap: 0.8rem;
            
            li a {
                color: white;
                text-decoration: none;
                font-size: 0.9rem;
                transition: color 0.3s ease;
                
                &:hover {
                    color: green;
                }
            }
        }
    }
</style>
