---
import { getCollection } from 'astro:content';
import { chapterHref, orderedChapters } from '../lib/chapters';
const sortedChapters = orderedChapters(await getCollection('chapters'));
---
<div class="sidebar" transition:persist id="sidebar">
    <div class="sidebar-content">
        <h1 class="book-title">Brother Dustfish</h1>
        <a href="#" id="coverTrigger">
            <img src="/images/3D-book-cover-sm.png" alt="Book Cover Preview" width="200" height="277" />
        </a>
        <div class="toc">
            <h2>Table of Contents</h2>
            <ul>
                {sortedChapters.map(chapter => (
                    <li>
                        <a href={chapterHref(chapter)}>
                            Chapter {chapter.data.number}: {chapter.data.title}
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </div>
</div>

<script>
    // The trigger is now in the Layout, but we still need the zoom logic
    const trigger = document.getElementById('coverTrigger');
    trigger?.addEventListener('click', (e) => {
        e.preventDefault();
        const zoom = document.getElementById('coverZoom');
        zoom?.classList.toggle('is-visible');
    });
</script>

<style lang="scss">
    .sidebar-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 2rem 1rem;
        text-align: center;
        color: var(--text-color-light);
    }

    .book-title {
        font-family: 'Georgia', serif;
        font-size: 3rem;
        font-weight: 900;
        margin: 1rem 0;
    }

    .toc {
        width: 100%;
        margin-top: 2rem;

        h2 {
            font-family: 'Georgia', serif;
            font-size: 1.6rem;
            margin-bottom: 1rem;
            // border-bottom: 1px solid var(--text-color-light);
            padding-bottom: 0.5rem;
        }

        ul {
            list-style: none;
            padding: 0;
            display: flex;
            flex-direction: column;
            justify-items: left;
            gap: 0.8rem;

            li a {
                color: var(--text-color-light);
                text-decoration: none;
                font-size: 0.9rem;
                transition: color 0.3s ease;

                &:hover {
                    color: var(--sidebar-link-hover);
                }
            }
        }
    }
</style>
