# Build output and caches
# `dist/` is Astro's default; `build/` is what astro.config.mjs sets via outDir.
# Both are listed because a build directory that is not ignored gets committed.
dist/
build/
.astro/
node_modules/

# Superpowers scratch: brainstorm sessions, SDD ledgers, throwaway scripts.
# Nothing here is a deliverable; the record that matters lives in git.
.superpowers/

# macOS
.DS_Store

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.*
!.env.example

# Git worktrees created by the superpowers worktree skill
.worktrees/
