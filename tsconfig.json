{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "checkJs": true,
    "jsxImportSource": "astro",
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"],
      "@pages/*": ["src/pages/*"],
      "@styles/*": ["src/styles/*"]
    }
  },
  // Deliberately NOT excluding .astro: astro/tsconfigs/strict includes
  // .astro/types.d.ts, which supplies the ImportMetaEnv types that dropHref's
  // `import.meta.env?.BASE_URL` relies on. Excluding it would untype that
  // expression and fail `astro check`.
  "exclude": ["dist", "node_modules", "the-hyperarticle", "stylesheets", "script.js", ".superpowers"]
}
